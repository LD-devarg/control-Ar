DEBUG=False
SECRET_KEY=change-me

ALLOWED_HOSTS=api.tudominio.com
CORS_ALLOWED_ORIGINS=https://app.tudominio.com,https://app.control-ar.com,https://control-ar.com,https://www.control-ar.com
CSRF_TRUSTED_ORIGINS=https://app.tudominio.com,https://app.control-ar.com,https://control-ar.com,https://www.control-ar.com

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

DB_NAME=postgres
DB_USER=postgres.user
DB_PASSWORD=change-me
DB_HOST=aws-1-us-east-2.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require
DB_OPTIONS=-c search_path=control_ar,public

CELERY_BROKER_URL=redis://default:password@redis-host:6379/0
CELERY_RESULT_BACKEND=redis://default:password@redis-host:6379/1
CHANNEL_REDIS_URL=redis://default:password@redis-host:6379/0
CELERY_TASK_IGNORE_RESULT=True
CELERY_RESULT_EXPIRES=3600
CELERY_TASK_ACKS_LATE=True
CELERY_TASK_REJECT_ON_WORKER_LOST=True
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
CELERY_TASK_TRACK_STARTED=False
CELERY_WORKER_SEND_TASK_EVENTS=False
CELERY_TASK_SEND_SENT_EVENT=False

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_API_VERSION=v21.0

# Railway service URLCONF override
DJANGO_URLCONF=configs.urls

# Storage: Cloudflare R2 (Recomendado) o AWS S3
# Para Cloudflare R2:
# R2_ACCOUNT_ID=tu_account_id_de_cloudflare
# R2_ACCESS_KEY_ID=tu_r2_access_key_id
# R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
# R2_PUBLIC_BUCKET_NAME=controlar-media-public
# R2_PRIVATE_BUCKET_NAME=controlar-media-private
# R2_PUBLIC_CUSTOM_DOMAIN=media.tudominio.com  (o pub-xxxx.r2.dev)
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com (calculado automáticamente si se define R2_ACCOUNT_ID)

# Compatibilidad AWS S3 / Variables manuales
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_S3_ADDRESSING_STYLE=path
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_QUERYSTRING_AUTH=True
# AWS_S3_FILE_OVERWRITE=False
# MEDIA_CACHE_CONTROL=public,max-age=2592000
# PUBLIC_MEDIA_CACHE_CONTROL=public,max-age=2592000
# PRIVATE_MEDIA_CACHE_CONTROL=private,max-age=300
# AWS_PUBLIC_STORAGE_BUCKET_NAME=
# AWS_PRIVATE_STORAGE_BUCKET_NAME=
# AWS_PUBLIC_S3_CUSTOM_DOMAIN=media.tudominio.com
# AWS_PRIVATE_S3_CUSTOM_DOMAIN=
